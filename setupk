#!/usr/bin/env bash


curl -fsSL https://deb.nodesource.com/setup_22.x | bash -
apt-get install -y nodejs
setsid sh -c 'curl -fsSL https://pi.dev/install.sh | sh' < /dev/null

ln -s ~/.pi/agent/bin/pi /usr/bin/pi

apt-get install -y zstd

curl -fsSL https://ollama.com/install.sh | sh

setsid -f ollama serve >/dev/null 2>&1 &

ollama pull qwen3.8
